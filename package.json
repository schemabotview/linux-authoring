{
  "name": "linux-authoring",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Linux courses and sections rendered with GraphL scenes, slides, and narration",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "npm run typecheck && node scripts/check-content.mjs",
    "preview": "vite preview",
    "build:snapshot": "vite build --outDir dist-snapshot",
    "capture": "vite preview --outDir dist-snapshot --port 5181",
    "capture:shots": "graphl-capture-shots",
    "record": "graphl-record",
    "record:reels": "graphl-record-reels",
    "shots:4k": "graphl-shots-4k",
    "gen:audio": "graphl-gen-audio",
    "gen:desc": "graphl-gen-desc",
    "thumb": "graphl-thumb",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graphlearning/flow": "1.2.0",
    "@graphlearning/shell": "file:vendor/graphlearning-shell-0.10.0.tgz",
    "@xyflow/react": "12.11.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
